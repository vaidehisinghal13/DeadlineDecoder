# Copy this file to .env.local and fill in your key. .env.local is gitignored.

# Required: your Google Gemini API key (server-side only, never exposed to the browser).
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model. Defaults to gemini-flash-lite-latest, a stable
# alias verified to work via the live API. (Pinned models like gemini-2.5-flash now
# return 404 "no longer available to new users" for new keys.) Verify what your key
# can access with the ListModels endpoint (see README).
# GEMINI_MODEL=gemini-flash-lite-latest
